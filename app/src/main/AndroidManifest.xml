<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bloque 2 de la Home (Busqueda con IA): unico bloque que necesita red. Solo se consulta el
         estado de conectividad (NetworkStatusSource); no hay trafico de red. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Proveedor de IA real (data.ai, Ktor): sin este permiso la primera peticion falla. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Aviso de fin del temporizador del modo cocina. `POST_NOTIFICATIONS` es obligatorio en
         Android 13+ para publicar la notificacion y se pide **en contexto**: la primera vez que el
         usuario arranca el temporizador de un paso y tras un rationale que explica para que sirve (ya
         **no** al abrir la app; ver `docs/specs/cooking-timer-alarm-permission-context.md`). Si lo
         deniega, el Modo cocina y su aviso en pantalla siguen intactos (el sistema descarta la
         notificacion en silencio). `USE_EXACT_ALARM`
         es un permiso **normal** (concedido al instalar) y es la via documentada para apps de
         temporizador: la alarma del aviso es exacta incluso en Doze; el adaptador degrada a alarma
         inexacta si el sistema no la concede. `VIBRATE` (normal, sin dialogo) habilita la vibracion del
         canal. La app no se publica en Play (ver docs/technical-discovery.md). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- `SCHEDULE_EXACT_ALARM` con `maxSdkVersion="32"`: con `minSdk = 33` **nunca** se concede ni se usa
         en runtime (en API 33+ la via es `USE_EXACT_ALARM`, que ya esta arriba). Se declara para que la
         comprobacion de lint de `setExactAndAllowWhileIdle` reconozca el caso de uso de alarma exacta
         (patron oficial del framework) y no emita un aviso nuevo sobre `data/cooking/`. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Servicio en primer plano que pinta la **cuenta atras** del temporizador del Modo cocina fuera de
         la app (feature `cooking-timer-foreground-service`). `FOREGROUND_SERVICE` es obligatorio para
         llamar a `startForeground` y `FOREGROUND_SERVICE_SPECIAL_USE` para el tipo `specialUse` en API
         34+: los dos son permisos **normales** (sin dialogo, concedidos al instalar). No existe un tipo
         de primer plano especifico para temporizadores (el mas afin, `shortService`, esta limitado a ~3
         minutos), asi que el caso de uso documentado del subtipo es "temporizador de cocina en curso,
         visible en la notificacion". La app no se publica en Play (`docs/technical-discovery.md`), de
         modo que no hay formulario de revision que rellenar. Sin estos permisos el servicio no arranca:
         el Modo cocina, la cuenta atras en pantalla y el "¡Listo!" siguen intactos (degradacion
         silenciosa, ADR 0005). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sazon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sazon"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receptor de la alarma del temporizador del modo cocina: publica la notificacion del aviso.
             `exported="false"`: el `PendingIntent` que lo lanza es explicito y de la misma app. -->
        <receiver
            android:name=".data.cooking.CookingAlarmReceiver"
            android:exported="false" />

        <!-- Servicio en primer plano que pinta la cuenta atras: mantiene viva la notificacion
             persistente mientras corre el temporizador. `exported="false"`: solo lo arranca la propia
             app (`startForegroundService` desde el adaptador del aviso). `stopWithTask` queda por
             defecto (`true`): quitar la tarea de recientes detiene el servicio (la sesion persistida
             sigue permitiendo volver al paso al tocar la notificacion del aviso). -->
        <service
            android:name=".data.cooking.CookingTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Temporizador de cocina en curso" />
        </service>
    </application>

</manifest>